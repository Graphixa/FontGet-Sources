# Environment variables for translator scripts and GitHub Actions.
#
# Local use: set variables in your shell (translators use os.getenv and do not load `.env` automatically):
#   export GOOGLE_FONTS_API_KEY=your-key-here
# Or copy this file to `.env` and load it with your shell/tool of choice before running Python.
#
# GitHub Actions: add each variable as a repository secret
# (Settings → Secrets and variables → Actions), then pass it in the workflow with `env:`.
#
# Example (see `.github/workflows/update-google-fonts.yml`):
#   env:
#     GOOGLE_FONTS_API_KEY: ${{ secrets.GOOGLE_FONTS_API_KEY }}

# Required by scripts/google-fonts-translator.py — get a key from Google Cloud / Web Fonts API.
GOOGLE_FONTS_API_KEY=

# Used only by translator-template.py copies when you model a key-protected API
# If making your own custom source, change this to match whatever you like but make sure to update in your workflows too.
YOUR_API_KEY=
